Global $g_aOffsets[5]  = [0x744, 0x734, 0x248, 0x8, 0xE0]


; Stats to monitor - Enum is just an index for addressing arrays.  No stats are stored in these
Enum $STAT_HP_MAX, $STAT_LVL, _
	$STAT_DEF_ALL, $STAT_DEF_PH, $STAT_DEF_EN, $STAT_DEF_ME, $STAT_DEF_BON, $STAT_DEF_DR, _  ; defense stats
	$STAT_BLK_ALL, $STAT_BLK_BON, $STAT_BLK_ADD, _ ; block - called deflect in client interface
	$STAT_DOD_ALL, $STAT_DOD_BON, $STAT_DOD_ADD, _ ; dodge
	$STAT_AS_ALL, $STAT_AS_PH, $STAT_AS_EN, $STAT_AS_ME, $STAT_AS_ML, $STAT_AS_RA, _ ; attack speed
	$STAT_DR_PH, $STAT_DR_EN, $STAT_DR_ME, $STAT_DR_ML, $STAT_DR_RA, $STAT_DR_AR, $STAT_DR_BOS, _  ; damage rating
	$STAT_BD_ALL, $STAT_BD_PH, $STAT_BD_EN, $STAT_BD_ME, $STAT_BD_ML, $STAT_BD_RA, $STAT_BD_AR, $STAT_BD_BOS, _ ; base damage
	$STAT_CR_ALL, $STAT_CR_PH, $STAT_CR_EN, $STAT_CR_ME, $STAT_CR_ML, $STAT_CR_RA, $STAT_CR_AR, _ ; crit rating
	$STAT_CB_PWR, $STAT_CB_ADD, $STAT_CB_SYN, $STAT_CB_PH, $STAT_CB_EN, $STAT_CB_ME, _ ; crit rating percent bonuses
	$STAT_CD_ALL, $STAT_CD_BAS, _ ; crit damage
	$STAT_SC_ALL, $STAT_SC_BON, _ ; super crit - called brutal in client interface
	$STAT_SD_ALL, $STAT_SD_BON, $STAT_SD_ADD, _ ; brutal damage and bonuses	
	$STAT_COUNT

; Each Enum slot: [PropID, "int64" | "sub_int64" | "hybrid_int64" | "float" | "sub_float" | "hybrid_float" , SubKey (0 if none)]
Global $g_aStatDefs[$STAT_COUNT][3] = [ _
	[481, "int64", 0], _	 						; HP_MAX
	[196, "int64", 0], _							; LVL character level
    [340, "sub_float", 0x2A900000], _		; DEF_ALL rating before bonuses

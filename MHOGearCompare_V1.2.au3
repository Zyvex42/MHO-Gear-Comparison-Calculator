	[231, "sub_float", 0x1CE86400], _		; CB_EN energy
	[231, "sub_float", 0x1CE0CC00], _		; CB_ME mental
	[226, "float", 0], _								; CD_ALL crit damage rating
	[225, "float", 0], _								; CD_BAS base crit base damage - includes infinity 
	[921, "float", 0], _								; SC_ALL brutal strike rating
	[916, "float", 0], _								; SC_BON brutal strike chance additive bonus
	[919, "float", 0], _								; SD_ALL brutal damage rating

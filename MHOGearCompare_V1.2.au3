	EndIf
	
EndFunc


; Only one instance may run. The newest launch wins: close every window with our
; title except our own process. The title is the shared identifier, so this works
; even when the previous instance is hidden. Bounded retry handles slow shutdown.
Func _EnsureSingleInstance()
	For $iAttempt = 1 To 30
		Local $aWindows = WinList($g_sWindowTitle)
		Local $bOldInstanceFound = False
		For $i = 1 To $aWindows[0][0]
			Local $iPid = WinGetProcess($aWindows[$i][1])
			If $iPid = @AutoItPID Or $iPid = -1 Or $iPid = 0 Then ContinueLoop
			$bOldInstanceFound = True
			ProcessClose($iPid)
		Next
		If Not $bOldInstanceFound Then Return True
		Sleep(100)
	Next
	MsgBox(0 + 48, $g_sWindowTitle, "Could not close the previous instance. Please close it manually and try again.")
	Exit
EndFunc


;------------------------------------------------------
; Title...........: _CreateScaledCtrl
; Description.....: Helper to create controls and store base layout
;------------------------------------------------------
Func _CreateScaledCtrl($sType, $sText, $iX, $iY, $iW, $iH, $iFont, $iStyle = -1, $iColor = -1)
	Local $idCtrl
	Switch $sType
		Case "Label"
			$idCtrl = GUICtrlCreateLabel($sText, $iX, $iY, $iW, $iH, $iStyle)
		Case "Input"
			$idCtrl = GUICtrlCreateInput($sText, $iX, $iY, $iW, $iH, $iStyle)
		Case "Checkbox"
			$idCtrl = GUICtrlCreateCheckbox($sText, $iX, $iY, $iW, $iH, $iStyle)
	EndSwitch

	GUICtrlSetFont($idCtrl, $iFont)
	If $iColor <> -1 Then GUICtrlSetColor($idCtrl, $iColor)

	; Save original coordinates and font size
	Local $iIndex = UBound($g_aCtrlLayout)
	ReDim $g_aCtrlLayout[$iIndex + 1][6]
	$g_aCtrlLayout[$iIndex][0] = $idCtrl
	$g_aCtrlLayout[$iIndex][1] = $iX
	$g_aCtrlLayout[$iIndex][2] = $iY
	$g_aCtrlLayout[$iIndex][3] = $iW
	$g_aCtrlLayout[$iIndex][4] = $iH
	$g_aCtrlLayout[$iIndex][5] = $iFont

	Return $idCtrl
EndFunc   ;==>_CreateScaledCtrl

;------------------------------------------------------
; Title...........: _guiScale
; Description.....: Resizes window and controls by scale factor
; Parameters......: $fScale - 0.6, 0.8, 1.0, 1.2, or 1.4
;------------------------------------------------------
Func _guiScale($fScale)
	; Calculate new client dimensions, keeping the 50px header unscaled
	Local $iNewClientW = Round($g_iBaseW * $fScale)
	Local $iNewClientH = $g_iTopHeaderH + Round(($g_iBaseH - $g_iTopHeaderH) * $fScale)

	; Adjust for window borders/titlebar so the inner client area matches exact proportions
	Local $aWinPos = WinGetPos($hGUI)
	Local $aClientSize = WinGetClientSize($hGUI)
	Local $iBorderW = $aWinPos[2] - $aClientSize[0]
	Local $iBorderH = $aWinPos[3] - $aClientSize[1]

	WinMove($hGUI, "", Default, Default, $iNewClientW + $iBorderW, $iNewClientH + $iBorderH)

	; Adjust $Label_status width only (maintaining its 85px left offset and 19px right margin)
	Local $iStatusW = $iNewClientW - 85 - 19
	If $iStatusW < 50 Then $iStatusW = 50 ; Prevent negative width at tiny scales
	GUICtrlSetPos($Label_status, 85, 10, $iStatusW, 26)

	; Loop through all scalable controls
	For $i = 0 To UBound($g_aCtrlLayout) - 1
		Local $idCtrl = $g_aCtrlLayout[$i][0]
		Local $iNewX = Round($g_aCtrlLayout[$i][1] * $fScale)
		; Offset Y by the fixed 50px header so nothing ever crosses above y = 50
		Local $iNewY = $g_iTopHeaderH + Round(($g_aCtrlLayout[$i][2] - $g_iTopHeaderH) * $fScale)
		Local $iNewW = Round($g_aCtrlLayout[$i][3] * $fScale)
		Local $iNewH = Round($g_aCtrlLayout[$i][4] * $fScale)
		Local $iNewFont = Round($g_aCtrlLayout[$i][5] * $fScale)
		GUICtrlSetPos($idCtrl, $iNewX, $iNewY, $iNewW, $iNewH)
		GUICtrlSetFont($idCtrl, $iNewFont)
	Next
	
	; Adjust $Label_status width and shrink font only below 1.0 scale
	Local $iStatusW = $iNewClientW - 85 - 19
	If $iStatusW < 50 Then $iStatusW = 50
	GUICtrlSetPos($Label_status, 85, 10, $iStatusW, 26)
	
	Local $iStatusFont = ($fScale < 1.0) ? Round(16 * $fScale) : 16
	GUICtrlSetFont($Label_status, $iStatusFont)
EndFunc   ;==>_guiScale

Func _ToggleWindowVisibility()
	$g_bWindowVisible = Not $g_bWindowVisible
	If $g_bWindowVisible Then
		GUISetState(@SW_SHOW, $hGUI)
		WinSetOnTop($hGUI, "", 1)
	Else
		GUISetState(@SW_HIDE, $hGUI)
	EndIf
EndFunc

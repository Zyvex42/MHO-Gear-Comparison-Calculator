	[923, "float", 0] _								; SD_ADD additive brutal damage percent
]

#EndRegion End of global variables and monitoring configuration

_guiCreate()
GUISetState(@SW_SHOWNORMAL)
;If BitAND(GUICtrlRead($Checkbox_lock), $GUI_CHECKED) Then
; =========================================================================
; LIVE MONITORING LOOP
; =========================================================================
While 1
    Switch GUIGetMsg()
        Case $GUI_EVENT_CLOSE
            ExitLoop
		Case $Checkbox_ph, $Checkbox_en, $Checkbox_me, $Checkbox_ml, $Checkbox_ra, $Checkbox_ar, $Checkbox_bi
			_UpdateUI()
			
    EndSwitch

    ; 2. Poll game memory on a clean timer
    If TimerDiff($hPollTimer) >= $iPollInterval Then
        $hPollTimer = TimerInit()

        $aStatsRead = _GetCharacterStats()
        Switch @error
            Case 0 ; Success: Game detected and reading stats
				Select 
					Case Not IsArray($aStatsOld)
						GUICtrlSetData($Label_status, "Comparing items:")
						$aStatsOld = $aStatsRead
						_UpdateUI()
					
					Case Not(IsArray($aStatsNew)) 
						If _StatsChanged($aStatsRead, $aStatsOld) Then 
							$aStatsNew = $aStatsRead
							_UpdateUI()
						EndIf
					
					Case IsArray($aStatsNew)
						If _StatsChanged($aStatsRead, $aStatsNew) Then
							If BitAND(GUICtrlRead($Checkbox_lock), $GUI_CHECKED) Then
								$aStatsNew = $aStatsRead
								_UpdateUI()
							Else 
								$aStatsOld = $aStatsNew
								$aStatsNew = $aStatsRead
								_UpdateUI()
							EndIf
						EndIf
				EndSelect
					

            Case 1 ; ProcessExists() = 0 (Game hasn't started yet or was closed)
                GUICtrlSetData($Label_status, "Game not detected...")
                $aStatsOld = 0 ; Reset so UI refreshes immediately when game relaunches
				$aStatsNew = 0 
				_UpdateUI()

            Case 4, 5 ; Game is open, but on Login / Character Select / Loading Screen
                GUICtrlSetData($Label_status, "Loading screen?")
                ; Keep previous stats on screen or clear them here depending on preference

            Case Else ; Handle open failed (e.g., not running as Admin)
                GUICtrlSetData($Label_status, "Requires Elevated Privilege!")
        EndSwitch
    EndIf
WEnd

GUIDelete($hGUI)
Exit

; =========================================================================
; STAT READER
; =========================================================================
Func _GetCharacterStats()
    Local Static $hProcess = 0, $iLastPID = 0, $pModuleBase = 0

    Local $iPID = ProcessExists($g_sProcessName)
    If Not $iPID Then Return SetError(1, 0, 0)

    If $iPID <> $iLastPID Or $hProcess = 0 Then
        If $hProcess <> 0 Then _WinAPI_CloseHandle($hProcess)
        $hProcess = _WinAPI_OpenProcess(0x0410, False, $iPID)
        If Not $hProcess Then Return SetError(2, 0, 0)

        Local $aModules = _WinAPI_EnumProcessModules($iPID)
        If @error Or UBound($aModules) < 2 Then Return SetError(3, 0, 0)
        Local $iRow = 1, $iCol = 0
        $pModuleBase = Number($aModules[$iRow][$iCol])
        $iLastPID = $iPID
    EndIf

    Local $pCurrent = _ReadUint64($hProcess, $pModuleBase + $g_iBaseOffset)
    Local $iLastIdx = UBound($g_aOffsets) - 1
    For $i = 0 To $iLastIdx - 1
        If $pCurrent = 0 Then Return SetError(4, 0, 0)
        $pCurrent = _ReadUint64($hProcess, $pCurrent + $g_aOffsets[$i])
    Next

    Local $pRBX = ($pCurrent = 0) ? 0 : ($pCurrent + $g_aOffsets[$iLastIdx])
    If $pRBX = 0 Then Return SetError(4, 0, 0)

    Local $aStats[$STAT_COUNT]
    For $d = 0 To $STAT_COUNT - 1
        $aStats[$d] = 0
    Next
	
	Local $bOk2 = _ParseBucketRange($hProcess, _ReadUint64($hProcess, $pRBX - 0x48), _ReadUint64($hProcess, $pRBX - 0x40), $aStats)
    Local $bOk1 = _ParseBucketRange($hProcess, _ReadUint64($hProcess, $pRBX + 0x08), _ReadUint64($hProcess, $pRBX + 0x10), $aStats)
    

    If Not $bOk1 And Not $bOk2 Then Return SetError(5, 0, 0)
    Return $aStats
EndFunc

; =========================================================================
; HELPER FUNCTIONS
; =========================================================================
Func _ParseBucketRange($hProc, $pBegin, $pEnd, ByRef $aStats)
    Local $iByteSize = $pEnd - $pBegin
    If $iByteSize <= 0 Or $iByteSize > 65536 Then Return False

    Local $tRawBuffer = DllStructCreate("byte[" & $iByteSize & "]")
    Local $pRawBuffer = DllStructGetPtr($tRawBuffer)
    Local $iBytesRead = 0
    If Not _WinAPI_ReadProcessMemory($hProc, $pBegin, $pRawBuffer, $iByteSize, $iBytesRead) Or $iBytesRead <> $iByteSize Then
        Return False
    EndIf

    Local $iColID = 0, $iColType = 1, $iColSub = 2
    Local $iBuckets = Int($iByteSize / 12)

    For $i = 0 To $iBuckets - 1
        Local $pBucket = $pRawBuffer + ($i * 12)
        Local $tHeader = DllStructCreate("ushort", $pBucket + 0x02)
        Local $iPropID = BitAND(DllStructGetData($tHeader, 1), 0x7FF)
        If $iPropID = 0x7FF Then ContinueLoop

        For $d = 0 To $STAT_COUNT - 1
            If $iPropID = $g_aStatDefs[$d][$iColID] Then
                Switch $g_aStatDefs[$d][$iColType]
                    Case "sub_float"
                        Local $tPtr = DllStructCreate("uint64", $pBucket + 0x04)
                        $aStats[$d] = _ReadCompoundSubKey($hProc, DllStructGetData($tPtr, 1), $g_aStatDefs[$d][$iColSub])

                    Case "hybrid_float"
                        Local $tRaw64 = DllStructCreate("uint64", $pBucket + 0x04)
                        Local $iVal64 = DllStructGetData($tRaw64, 1)
                        If $iVal64 > 0x10000000000 And $iVal64 < 0x7FFFFFFFFFFF Then
                            $aStats[$d] = _ReadCompoundSubKey($hProc, $iVal64, $g_aStatDefs[$d][$iColSub])
                        Else
                            Local $tDirectFlt = DllStructCreate("float", $pBucket + 0x04)
                            $aStats[$d] = DllStructGetData($tDirectFlt, 1)
                        EndIf

                    Case Else ; "int64" or "float"
                        Local $tVal = DllStructCreate($g_aStatDefs[$d][$iColType], $pBucket + 0x04)
                        $aStats[$d] = DllStructGetData($tVal, 1)
                EndSwitch
            EndIf
        Next
    Next

    Return True
EndFunc

Func _ReadCompoundSubKey($hProc, $pSubStruct, $iTargetSubKey)
    If $pSubStruct <= 0x10000000000 Or $pSubStruct >= 0x7FFFFFFFFFFF Then Return 0

    Local $tCount = DllStructCreate("ushort")
    Local $iRead = 0
    If Not _WinAPI_ReadProcessMemory($hProc, $pSubStruct + 0x02, DllStructGetPtr($tCount), 2, $iRead) Or $iRead <> 2 Then Return 0
    Local $iCount = DllStructGetData($tCount, 1)
    If $iCount = 0 Or $iCount > 32 Then Return 0

    Local $iBytes = $iCount * 16
    Local $tBuf = DllStructCreate("byte[" & $iBytes & "]")
    Local $pBuf = DllStructGetPtr($tBuf)
    If Not _WinAPI_ReadProcessMemory($hProc, $pSubStruct + 0x08, $pBuf, $iBytes, $iRead) Or $iRead <> $iBytes Then Return 0

    For $i = 0 To $iCount - 1
        Local $pEntry = $pBuf + ($i * 16)
        Local $tKey = DllStructCreate("uint", $pEntry + 0x00)
        If DllStructGetData($tKey, 1) = $iTargetSubKey Then
            Local $tVal = DllStructCreate("float", $pEntry + 0x04)
            Return DllStructGetData($tVal, 1)
        EndIf
    Next

    Return 0
EndFunc

Func _StatsChanged($aOld, $aNew)
    If Not IsArray($aOld) Or Not IsArray($aNew) Then Return True
    For $i = 0 To $STAT_COUNT - 1
        If $aOld[$i] <> $aNew[$i] Then 
			Return True
		EndIf
    Next
    Return False
EndFunc

Func _ReadUint64($hProc, $pAddr)
    Local $tBuf = DllStructCreate("uint64")
    Local $iRead = 0
    If Not _WinAPI_ReadProcessMemory($hProc, $pAddr, DllStructGetPtr($tBuf), 8, $iRead) Or $iRead <> 8 Then Return 0
    Return DllStructGetData($tBuf, 1)
EndFunc

Func _UpdateUI()
	If Not IsArray($aStatsOld) Then
		;clear UI because game closed
		GUICtrlSetData($Input_ohealth, "")
		GUICtrlSetData($Input_odef, "")
		GUICtrlSetData($Input_odefl, "")
		GUICtrlSetData($Input_odod, "")
		GUICtrlSetData($Input_odr, "")
		GUICtrlSetData($Input_oehp, "")
		GUICtrlSetData($Input_obd, "")
		GUICtrlSetData($Input_oas, "")
		GUICtrlSetData($Input_occ, "")
		GUICtrlSetData($Input_ocd, "")
		GUICtrlSetData($Input_osc, "")
		GUICtrlSetData($Input_osd, "")
		GUICtrlSetData($Input_nhealth, "")
		GUICtrlSetData($Input_ndef, "")
		GUICtrlSetData($Input_ndefl, "")
		GUICtrlSetData($Input_ndod, "")
		GUICtrlSetData($Input_ndr, "")
		GUICtrlSetData($Input_nehp, "")
		GUICtrlSetData($Input_nbd, "")
		GUICtrlSetData($Input_nas, "")
		GUICtrlSetData($Input_ncc, "")
		GUICtrlSetData($Input_ncd, "")
		GUICtrlSetData($Input_nsc, "")
		GUICtrlSetData($Input_nsd, "")
		GUICtrlSetData($Input_newdam, "")
		GUICtrlSetData($Label_chealth, "")
		GUICtrlSetData($Label_cdef, "")
		GUICtrlSetData($Label_cdefl, "")
		GUICtrlSetData($Label_cdod, "")
		GUICtrlSetData($Label_cdr, "")
		GUICtrlSetData($Label_cehp, "")
		GUICtrlSetData($Label_cbd, "")
		GUICtrlSetData($Label_cas, "")
		GUICtrlSetData($Label_ccc, "")
		GUICtrlSetData($Label_ccd, "")
		GUICtrlSetData($Label_csc, "")
		GUICtrlSetData($Label_csd, "")
		GUICtrlSetData($Label_cnewdam, "")
		Return
	EndIf
	
	; do calculations on old stats
	#Region old stats side calculations
	; Defense - For practical purposes, Phys/Ment/Energy defenses are averaged and added to overall defense
	; The game calculates defense based on your highest applicable stat, but we don't know what damage types incoming attacks will be
	Local $old_def = ($aStatsOld[$STAT_DEF_ALL] + _
		(($aStatsOld[$STAT_DEF_PH] + $aStatsOld[$STAT_DEF_EN] + $aStatsOld[$STAT_DEF_ME]) / 3)) * _
		(1 + $aStatsOld[$STAT_DEF_BON])
	
	Local $old_def_dr = _ 
		(0.4 * $old_def) _
		/ _
		($old_def + (200 * $aStatsOld[$STAT_LVL]))
	
	; Block aka deflect
	Local $old_blk = $aStatsOld[$STAT_BLK_ALL] * (1 + $aStatsOld[$STAT_BLK_BON])
	
	Local $old_blk_dr = $aStatsOld[$STAT_BLK_ADD] + _
		(0.9 * $old_blk) _
		/ _
		($old_blk + (250 * $aStatsOld[$STAT_LVL]))
	
	; Dodge
	Local $old_dod = $aStatsOld[$STAT_DOD_ALL] * (1 + $aStatsOld[$STAT_DOD_BON])
	
	Local $old_dod_dr = $aStatsOld[$STAT_DOD_ADD] + _
		(0.45 * $old_dod) _
		/ _
		($old_dod + (250 * $aStatsOld[$STAT_LVL]))
	
	
	; DR = total mitigation, not just damage reduction as displayed in the character screen
	Local $old_dr = $old_def_dr + (0.2 * $old_blk_dr) + (0.4 * $old_dod_dr) + $aStatsOld[$STAT_DEF_DR]
	If $old_dr > 0.9 Then
		$old_dr = 0.9
	EndIf
	$old_dr = 1 - ((1 - $old_dr) * (1 - $old_dod_dr) * (1 - (0.5 * $old_blk_dr)))

	; EHP
	Local $old_ehp = $aStatsOld[$STAT_HP_MAX] * (1 - $old_dr)
	
	; Base damage - includes damage vs bosses - converts rating to percent then adds all percents
	Local $old_base = ( _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsOld[$STAT_DR_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsOld[$STAT_DR_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsOld[$STAT_DR_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsOld[$STAT_DR_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsOld[$STAT_DR_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsOld[$STAT_DR_AR]) + _
		$aStatsOld[$STAT_DR_BOS] _
		) _
		/ _
		4000
		
	$old_base = $old_base + _
		$aStatsOld[$STAT_BD_ALL] + _
		$aStatsOld[$STAT_BD_BOS] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsOld[$STAT_BD_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsOld[$STAT_BD_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsOld[$STAT_BD_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsOld[$STAT_BD_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsOld[$STAT_BD_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsOld[$STAT_BD_AR])
		
	; Attack speed
	Local $old_as = 0.40 * (1 - Exp( -3 * ( _
		$aStatsOld[$STAT_AS_ALL] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsOld[$STAT_AS_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsOld[$STAT_AS_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsOld[$STAT_AS_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsOld[$STAT_AS_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsOld[$STAT_AS_RA]) _
		)))
	
	; Crit chance - calculates rating first then converts to percent
	Local $old_cc = ( $aStatsOld[$STAT_CR_ALL] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsOld[$STAT_CR_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsOld[$STAT_CR_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsOld[$STAT_CR_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsOld[$STAT_CR_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsOld[$STAT_CR_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsOld[$STAT_CR_AR]) ) _
		* ( 1 + _ 
		$aStatsOld[$STAT_CB_SYN] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsOld[$STAT_CB_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsOld[$STAT_CB_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsOld[$STAT_CB_ME]))
	
	$old_cc = ((0.89 * $old_cc) / _
		($old_cc + (80 * $aStatsOld[$STAT_LVL]))) + _
		0.1 + $aStatsOld[$STAT_CB_ADD]
	
	; crit damage
	Local $old_cd = (($aStatsOld[$STAT_CD_ALL]) / 8000) + $aStatsOld[$STAT_CD_BAS]
	
	; brutal strike chance - super crit
	Local $old_sc = ((0.89 * $aStatsOld[$STAT_SC_ALL]) / _
		($aStatsOld[$STAT_SC_ALL] + (80 * $aStatsOld[$STAT_LVL]))) + _
		$aStatsOld[$STAT_SC_BON]
		
	$old_sc = $old_sc * (Not BitAND(GUICtrlRead($Checkbox_bi), $GUI_CHECKED))
	
	; brutal damage
	Local $old_sd = (($aStatsOld[$STAT_SD_ALL]) / 8000) + $aStatsOld[$STAT_SD_BON] + $old_cd
	
	$old_sd = $old_sd * (Not BitAND(GUICtrlRead($Checkbox_bi), $GUI_CHECKED))
		
	; real crit chance because brutals reduce how often you crit
	Local $old_cc_real = $old_cc * (1 - $old_sc)
	
	; real brutal chance because brutals only happen if you crit first
	Local $old_sc_real = $old_cc * $old_sc
	
	#EndRegion old stats calcualtions
	

	; update old ui boxes
	GUICtrlSetData($Input_ohealth, StringRegExpReplace(Round($aStatsOld[$STAT_HP_MAX],0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_odef, StringRegExpReplace(Round($old_def,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_odefl, StringRegExpReplace(Round($old_blk,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_odod, StringRegExpReplace(Round($old_dod,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_odr, Round($old_dr * 100, 2) & "%" )
	GUICtrlSetData($Input_oehp, StringRegExpReplace(Round($old_ehp,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_obd,Round($old_base * 100, 2) & "%")
	GUICtrlSetData($Input_oas, Round($old_as * 100, 2) & "%")
	GUICtrlSetData($Input_occ, Round($old_cc_real * 100, 2) & "%")
	GUICtrlSetData($Input_ocd, Round($old_cd * 100, 2) & "%")
	GUICtrlSetData($Input_osc, Round($old_sc_real * 100, 2) & "%")
	GUICtrlSetData($Input_osd, Round($old_sd * 100, 2) & "%")
	
	
	
	
	
	; 	new stats calculations
	#Region new calculations
	If Not IsArray($aStatsNew) Then Return ; first time filling in UI
	
	; Defense - For practical purposes, Phys/Ment/Energy defenses are averaged and added to overall defense
	; The game calculates defense based on your highest applicable stat, but we don't know what damage types incoming attacks will be
	Local $new_def = ($aStatsNew[$STAT_DEF_ALL] + _
		(($aStatsNew[$STAT_DEF_PH] + $aStatsNew[$STAT_DEF_EN] + $aStatsNew[$STAT_DEF_ME]) / 3)) * _
		(1 + $aStatsNew[$STAT_DEF_BON])
	
	Local $new_def_dr = _ 
		(0.4 * $new_def) _
		/ _
		($new_def + (200 * $aStatsNew[$STAT_LVL]))
	
	; Block aka deflect
	Local $new_blk = $aStatsNew[$STAT_BLK_ALL] * (1 + $aStatsNew[$STAT_BLK_BON])
	
	Local $new_blk_dr = $aStatsNew[$STAT_BLK_ADD] + _
		(0.9 * $new_blk) _
		/ _
		($new_blk + (250 * $aStatsNew[$STAT_LVL]))
	
	; Dodge
	Local $new_dod = $aStatsNew[$STAT_DOD_ALL] * (1 + $aStatsNew[$STAT_DOD_BON])
	
	Local $new_dod_dr = $aStatsNew[$STAT_DOD_ADD] + _
		(0.45 * $new_dod) _
		/ _
		($new_dod + (250 * $aStatsNew[$STAT_LVL]))
	
	
	; DR = total mitigation, not just damage reduction as displayed in the character screen
	Local $new_dr = $new_def_dr + (0.2 * $new_blk_dr) + (0.4 * $new_dod_dr) + $aStatsNew[$STAT_DEF_DR]
	If $new_dr > 0.9 Then
		$new_dr = 0.9
	EndIf
	$new_dr = 1 - ((1 - $new_dr) * (1 - $new_dod_dr) * (1 - (0.5 * $new_blk_dr)))

	; EHP
	Local $new_ehp = $aStatsNew[$STAT_HP_MAX] * (1 - $new_dr)
	
	; Base damage - includes damage vs bosses - converts rating to percent then adds all percents
	Local $new_base = ( _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsNew[$STAT_DR_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsNew[$STAT_DR_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsNew[$STAT_DR_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsNew[$STAT_DR_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsNew[$STAT_DR_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsNew[$STAT_DR_AR]) + _
		$aStatsNew[$STAT_DR_BOS] _
		) _
		/ _
		4000
		
	$new_base = $new_base + _
		$aStatsNew[$STAT_BD_ALL] + _
		$aStatsNew[$STAT_BD_BOS] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsNew[$STAT_BD_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsNew[$STAT_BD_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsNew[$STAT_BD_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsNew[$STAT_BD_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsNew[$STAT_BD_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsNew[$STAT_BD_AR])
		
	; Attack speed
	Local $new_as = 0.40 * (1 - Exp( -3 * ( _
		$aStatsNew[$STAT_AS_ALL] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsNew[$STAT_AS_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsNew[$STAT_AS_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsNew[$STAT_AS_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsNew[$STAT_AS_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsNew[$STAT_AS_RA]) _
		)))
	
	; Crit chance - calculates rating first then converts to percent
	Local $new_cc = ( $aStatsNew[$STAT_CR_ALL] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsNew[$STAT_CR_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsNew[$STAT_CR_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsNew[$STAT_CR_ME]) + _
		(BitAND(GUICtrlRead($Checkbox_ml), $GUI_CHECKED) * $aStatsNew[$STAT_CR_ML]) + _
		(BitAND(GUICtrlRead($Checkbox_ra), $GUI_CHECKED) * $aStatsNew[$STAT_CR_RA]) + _
		(BitAND(GUICtrlRead($Checkbox_ar), $GUI_CHECKED) * $aStatsNew[$STAT_CR_AR]) ) _
		* ( 1 + _ 
		$aStatsNew[$STAT_CB_SYN] + _
		(BitAND(GUICtrlRead($Checkbox_ph), $GUI_CHECKED) * $aStatsNew[$STAT_CB_PH]) + _
		(BitAND(GUICtrlRead($Checkbox_en), $GUI_CHECKED) * $aStatsNew[$STAT_CB_EN]) + _
		(BitAND(GUICtrlRead($Checkbox_me), $GUI_CHECKED) * $aStatsNew[$STAT_CB_ME]))
	
	$new_cc = ((0.89 * $new_cc) / _
		($new_cc + (80 * $aStatsNew[$STAT_LVL]))) + _
		0.1 + $aStatsNew[$STAT_CB_ADD]
	
	; crit damage
	Local $new_cd = (($aStatsNew[$STAT_CD_ALL]) / 8000) + $aStatsNew[$STAT_CD_BAS]
	
	; brutal strike chance - super crit
	Local $new_sc = ((0.89 * $aStatsNew[$STAT_SC_ALL]) / _
		($aStatsNew[$STAT_SC_ALL] + (80 * $aStatsNew[$STAT_LVL]))) + _
		$aStatsNew[$STAT_SC_BON]
	
	$new_sc = $new_sc * (Not BitAND(GUICtrlRead($Checkbox_bi), $GUI_CHECKED))
	
	; brutal damage
	Local $new_sd = (($aStatsNew[$STAT_SD_ALL]) / 8000) + $aStatsNew[$STAT_SD_BON] + $new_cd
	
	$new_sd = $new_sd * (Not BitAND(GUICtrlRead($Checkbox_bi), $GUI_CHECKED))
		
	; real crit chance because brutals reduce how often you crit
	Local $new_cc_real = $new_cc * (1 - $new_sc)
	
	; real brutal chance because brutals only happen if you crit first
	Local $new_sc_real = $new_cc * $new_sc
	
	#EndRegion new stats calcualtions
	

	; update new ui boxes
	GUICtrlSetData($Input_nhealth, StringRegExpReplace(Round($aStatsNew[$STAT_HP_MAX],0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_ndef, StringRegExpReplace(Round($new_def,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_ndefl, StringRegExpReplace(Round($new_blk,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_ndod, StringRegExpReplace(Round($new_dod,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_ndr, Round($new_dr * 100, 2) & "%" )
	GUICtrlSetData($Input_nehp, StringRegExpReplace(Round($new_ehp,0), "(\d)(?=(\d{3})+$)", "$1,"))
	GUICtrlSetData($Input_nbd,Round($new_base * 100, 2) & "%")
	GUICtrlSetData($Input_nas, Round($new_as * 100, 2) & "%")
	GUICtrlSetData($Input_ncc, Round($new_cc_real * 100, 2) & "%")
	GUICtrlSetData($Input_ncd, Round($new_cd * 100, 2) & "%")
	GUICtrlSetData($Input_nsc, Round($new_sc_real * 100, 2) & "%")
	GUICtrlSetData($Input_nsd, Round($new_sd * 100, 2) & "%")
	

	; calculate final damage for comparison
	; this uses a theoretical 1 damage attack with no variance so we can have an easy percent change

	Local $old_fd = ((1 + $old_base) * (1 - $old_cc)) + _  		; non crit damage
		((1 + $old_base) * (1 + $old_cd) * $old_cc_real) + _ 	; crit damage
		((1 + $old_base) * (1 + $old_sd) * $old_sc_real)  			; brutal damage
	
	Local $new_fd = ((1 + $new_base) * (1 - $new_cc)) + _  		; non crit damage
		((1 + $new_base) * (1 + $new_cd) * $new_cc_real) + _ 	; crit damage
		((1 + $new_base) * (1 + $new_sd) * $new_sc_real)  			; brutal damage
	
	GUICtrlSetData($Input_newdam, Round((($new_fd - $old_fd) / $old_fd) * 100, 2) & "%")
	
	; update comparisons
	If $aStatsOld[$STAT_HP_MAX] > $aStatsNew[$STAT_HP_MAX] Then
		GUICtrlSetData($Label_chealth, ChrW(0x25BC))
		GUICtrlSetColor($Label_chealth, 0xFF0000)
	ElseIf $aStatsOld[$STAT_HP_MAX] < $aStatsNew[$STAT_HP_MAX] Then
		GUICtrlSetData($Label_chealth, ChrW(0x25B2))
		GUICtrlSetColor($Label_chealth, 0x00FF00)
	Else
		GUICtrlSetData($Label_chealth, "=")
		GUICtrlSetColor($Label_chealth, 0x00000)
	EndIf
	
	If $old_def > $new_def Then
		GUICtrlSetData($Label_cdef, ChrW(0x25BC))
		GUICtrlSetColor($Label_cdef, 0xFF0000)
	ElseIf $old_def < $new_def Then
		GUICtrlSetData($Label_cdef, ChrW(0x25B2))
		GUICtrlSetColor($Label_cdef, 0x00FF00)
	Else
		GUICtrlSetData($Label_cdef, "=")
		GUICtrlSetColor($Label_cdef, 0x00000)
	EndIf
	
	If $old_blk > $new_blk Then
		GUICtrlSetData($Label_cdefl, ChrW(0x25BC))
		GUICtrlSetColor($Label_cdefl, 0xFF0000)
	ElseIf $old_blk < $new_blk Then
		GUICtrlSetData($Label_cdefl, ChrW(0x25B2))
		GUICtrlSetColor($Label_cdefl, 0x00FF00)
	Else
		GUICtrlSetData($Label_cdefl, "=")
		GUICtrlSetColor($Label_cdefl, 0x00000)
	EndIf
	
	If $old_dod > $new_dod Then
		GUICtrlSetData($Label_cdod, ChrW(0x25BC))
		GUICtrlSetColor($Label_cdod, 0xFF0000)
	ElseIf $old_dod < $new_dod Then
		GUICtrlSetData($Label_cdod, ChrW(0x25B2))
		GUICtrlSetColor($Label_cdod, 0x00FF00)
	Else
		GUICtrlSetData($Label_cdod, "=")
		GUICtrlSetColor($Label_cdod, 0x00000)
	EndIf
	
	If $old_dr > $new_dr Then
		GUICtrlSetData($Label_cdr, ChrW(0x25BC))
		GUICtrlSetColor($Label_cdr, 0xFF0000)
	ElseIf $old_dr < $new_dr Then
		GUICtrlSetData($Label_cdr, ChrW(0x25B2))
		GUICtrlSetColor($Label_cdr, 0x00FF00)
	Else
		GUICtrlSetData($Label_cdr, "=")
		GUICtrlSetColor($Label_cdr, 0x00000)
	EndIf
	
	If $old_ehp > $new_ehp Then
		GUICtrlSetData($Label_cehp, ChrW(0x25BC))
		GUICtrlSetColor($Label_cehp, 0xFF0000)
	ElseIf $old_ehp < $new_ehp Then
		GUICtrlSetData($Label_cehp, ChrW(0x25B2))
		GUICtrlSetColor($Label_cehp, 0x00FF00)
	Else
		GUICtrlSetData($Label_cehp, "=")
		GUICtrlSetColor($Label_cehp, 0x00000)
	EndIf
	
	If $old_base > $new_base Then
		GUICtrlSetData($Label_cbd, ChrW(0x25BC))
		GUICtrlSetColor($Label_cbd, 0xFF0000)
	ElseIf $old_base < $new_base Then
		GUICtrlSetData($Label_cbd, ChrW(0x25B2))
		GUICtrlSetColor($Label_cbd, 0x00FF00)
	Else
		GUICtrlSetData($Label_cbd, "=")
		GUICtrlSetColor($Label_cbd, 0x00000)
	EndIf
	
	If $old_as > $new_as Then
		GUICtrlSetData($Label_cas, ChrW(0x25BC))
		GUICtrlSetColor($Label_cas, 0xFF0000)
	ElseIf $old_as < $new_as Then
		GUICtrlSetData($Label_cas, ChrW(0x25B2))
		GUICtrlSetColor($Label_cas, 0x00FF00)
	Else
		GUICtrlSetData($Label_cas, "=")
		GUICtrlSetColor($Label_cas, 0x00000)
	EndIf
	
	If $old_cc_real > $new_cc_real Then
		GUICtrlSetData($Label_ccc, ChrW(0x25BC))
		GUICtrlSetColor($Label_ccc, 0xFF0000)
	ElseIf $old_cc_real < $new_cc_real Then
		GUICtrlSetData($Label_ccc, ChrW(0x25B2))
		GUICtrlSetColor($Label_ccc, 0x00FF00)
	Else
		GUICtrlSetData($Label_ccc, "=")
		GUICtrlSetColor($Label_ccc, 0x00000)
	EndIf
	
	If $old_cd > $new_cd Then
		GUICtrlSetData($Label_ccd, ChrW(0x25BC))
		GUICtrlSetColor($Label_ccd, 0xFF0000)
	ElseIf $old_cd < $new_cd Then
		GUICtrlSetData($Label_ccd, ChrW(0x25B2))
		GUICtrlSetColor($Label_ccd, 0x00FF00)
	Else
		GUICtrlSetData($Label_ccd, "=")
		GUICtrlSetColor($Label_ccd, 0x00000)
	EndIf
	
	If $old_sc_real > $new_sc_real Then
		GUICtrlSetData($Label_csc, ChrW(0x25BC))
		GUICtrlSetColor($Label_csc, 0xFF0000)
	ElseIf $old_sc_real < $new_sc_real Then
		GUICtrlSetData($Label_csc, ChrW(0x25B2))
		GUICtrlSetColor($Label_csc, 0x00FF00)
	Else
		GUICtrlSetData($Label_csc, "=")
		GUICtrlSetColor($Label_csc, 0x00000)
	EndIf
	
	If $old_sd > $new_sd Then
		GUICtrlSetData($Label_csd, ChrW(0x25BC))
		GUICtrlSetColor($Label_csd, 0xFF0000)
	ElseIf $old_sd < $new_sd Then
		GUICtrlSetData($Label_csd, ChrW(0x25B2))
		GUICtrlSetColor($Label_csd, 0x00FF00)
	Else
		GUICtrlSetData($Label_csd, "=")
		GUICtrlSetColor($Label_csd, 0x00000)
	EndIf
	
	If $old_fd > $new_fd Then
		GUICtrlSetData($Label_cnewdam, ChrW(0x25BC))
		GUICtrlSetColor($Label_cnewdam, 0xFF0000)
	ElseIf $old_fd < $new_fd Then
		GUICtrlSetData($Label_cnewdam, ChrW(0x25B2))
		GUICtrlSetColor($Label_cnewdam, 0x00FF00)
	Else
		GUICtrlSetData($Label_cnewdam, "=")
		GUICtrlSetColor($Label_cnewdam, 0x00000)
	EndIf
	
EndFunc
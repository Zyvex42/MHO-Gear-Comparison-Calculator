	[183, "hybrid_float", 0x16EC3400], _	; AS_PH physical attack speed
	[183, "sub_float", 0x16E86400], _		; AS_EN energy
	[183, "sub_float", 0x16E0CC00], _		; AS_ME mental
	[183, "sub_float", 0x16EF2C00], _		; AS_ML melee
	[183, "sub_float", 0x16E65C00], _		; AS_RA range
	[309, "hybrid_float", 0x26A00000], _  ; DR_PH physical damage rating
	[309, "sub_float", 0x26A40000], _  	; DR_EN energy
	[309, "sub_float", 0x26A80000], _  	; DR_ME mental
	[309, "sub_float", 0x276F2C00], _ 		; DR_ML melee
	[309, "sub_float", 0x27665C00], _		; DR_RA range

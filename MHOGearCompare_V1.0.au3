	$STAT_CR_ALL, $STAT_CR_PH, $STAT_CR_EN, $STAT_CR_ME, $STAT_CR_ML, $STAT_CR_RA, $STAT_CR_AR, _ ; crit rating
	$STAT_CB_PWR, $STAT_CB_ADD, $STAT_CB_SYN, $STAT_CB_PH, $STAT_CB_EN, $STAT_CB_ME, _ ; crit rating percent bonuses
	$STAT_CD_ALL, $STAT_CD_BAS, _ ; crit damage
	$STAT_SC_ALL, $STAT_SC_BON, _ ; super crit - called brutal in client interface
	$STAT_SD_ALL, $STAT_SD_BON, $STAT_SD_ADD, _ ; brutal damage and bonuses	
	$STAT_COUNT

; Each Enum slot: [PropID, "int64" | "sub_int64" | "hybrid_int64" | "float" | "sub_float" | "hybrid_float" , SubKey (0 if none)]
Global $g_aStatDefs[$STAT_COUNT][3] = [ _
	[481, "int64", 0], _	 						; HP_MAX
	[196, "int64", 0], _							; LVL character level
    [340, "sub_float", 0x2A900000], _		; DEF_ALL rating before bonuses

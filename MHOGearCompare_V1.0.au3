	[290, "float", 0], _								; BD_BOS boss
	[228, "float", 0], _								; CR_ALL crit rating
	[230, "hybrid_float", 0x1CCC3400], _	; CR_PH physical
	[230, "sub_float", 0x1CC86400], _		; CR_EN energy
